{
  "rewrites": [
    { "source": "/worksheet/download", "destination": "/worksheet/download.html" },
    { "source": "/worksheet/download/:src(ig|tt)", "destination": "/worksheet/download.html" },
    { "source": "/worksheet/:src(ig|tt)", "destination": "/worksheet/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=\"PayWindow-Budget-Worksheet.pdf\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
